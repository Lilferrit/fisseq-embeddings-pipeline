// nextflow.config -- executor/profile/container settings only. No default
// parameter values live here; those are in params.yaml, loaded explicitly
// via `-params-file params.yaml`.
//
// pass with: nextflow run . --pipeline_dir /path/to/experiment \
//   -params-file params.yaml [-profile docker|sge] [other overrides]

docker {
    enabled = true
}

process {
    // params.container_image itself has a default in params.yaml -- read
    // here without ever declaring a `params {}` block of our own, since
    // `params.*` is always implicitly available in nextflow.config (it
    // resolves to null, harmlessly, if params.yaml wasn't loaded --
    // fails loudly downstream instead, per §9.1's Resolved note). An
    // empty top-level `params {}` block used to sit here for the same
    // purpose, but it triggers a real Nextflow <26 bug: combined with
    // `-params-file`, ConfigBuilder misattributes every params.yaml key
    // into this process {} scope instead of top-level, raising "Unknown
    // config attribute `params`" (confirmed against Nextflow 25.10.4;
    // fixed by 26.04.6). Don't reintroduce an empty `params {}` block here.
    // Every process module declares its own `container "${params...}"`
    // directive inline (see e.g. modules/local/build_dataset/main.nf), which
    // takes precedence over this blanket default -- this line only
    // matters as a fallback for a process that doesn't. Every module,
    // including BUILD_CELL_IMAGES (modules/local/build_cell_images/main.nf),
    // uses this one image -- starcall-workflow's own dependency stack now
    // lives inside it as an isolated `ops` conda env rather than as a
    // separate image (see the root Dockerfile).
    container = params.container_image
    // BUILD_CELL_IMAGES' one snakemake invocation (modules/local/
    // build_cell_images/main.nf): the ops conda env's absolute path by
    // default, matching where the root Dockerfile installs it -- NOT
    // bare `snakemake`, deliberately, since that env is kept off PATH so
    // bare `python`/`snakemake` never ambiguously resolves into its
    // Python 3.10 instead of this repo's own 3.13 venv. A process
    // directive (`ext`), not a params.yaml value -- see that file's own
    // comment on why -profile local's override below needs this scope
    // rather than params.snakemake_bin.
    ext.snakemake_bin = '/opt/conda/envs/ops/bin/snakemake'
    // --use-conda (build_cell_images/main.nf's one snakemake invocation) shells
    // out to a bare `conda` internally (Conda().prefix_path) regardless of
    // snakemake_bin's own absolute path -- and conda's own base env is
    // deliberately kept off this image's default PATH too (same Dockerfile
    // reasoning as snakemake_bin above), so build_cell_images/main.nf prepends
    // this directory onto PATH for just that one invocation instead.
    // -profile local has no /opt/conda at all, so it clears this back to
    // '' below (build_cell_images/main.nf skips the PATH= prefix entirely when
    // empty, rather than emitting a no-op one).
    ext.conda_bin_dir = '/opt/conda/bin'
    // BUILD_CELL_IMAGES points `--snakefile` directly at the static
    // wrapper.smk template baked into the image at this fixed path (see
    // Dockerfile's `COPY resources/ resources/` and docs/architecture.md
    // decision 17/18), instead of starcall-workflow's own Snakefile
    // directly -- this is how `rule make_cell_images_bbox` (resources/
    // starcall_overrides/fixed_cell_images.smk) gets composed in via
    // `ruleorder:`. wrapper.smk itself reads starcall_workflow_dir out of
    // `config` (populated by build_cell_images/main.nf's own `--config`),
    // so no per-task copy or text substitution of these files is needed.
    // -profile local has no baked image at all, so it points this at the
    // checked-out repo's own copy below.
    ext.starcall_overrides_dir = '/opt/fisseq-embeddings-pipeline/resources/starcall_overrides'

    withLabel: 'process_gpu' {
        // --gpus all: this pipeline's only GPU-bound process (EMBED_CELLS,
        // label 'process_gpu') -- but only when params.cell_dino_device
        // actually asks for one. `docker run --gpus all` fails outright
        // ("Error response from daemon: failed to discover GPU vendor from
        // CDI: no known GPU vendor found") on a host with no GPU/no
        // nvidia-container-toolkit, independent of whatever
        // cell_dino_device itself is set to -- confirmed directly running
        // tests/integration/test_integration.py's --container mode's own
        // from-scratch, CPU-sized checkpoint (see that module's own
        // `_write_tiny_checkpoint`/`_WINDOW` comments -- "small enough to
        // run fast on CPU" was always the intent) with
        // cell_dino_device=cpu on a GPU-less host: still failed on this
        // flag alone, before EMBED_CELLS' own Python even started.
        // Skipping `--gpus all` whenever cell_dino_device is 'cpu' is what
        // actually lets that CPU path run in a real container -- unlike
        // `-profile local` (docker.enabled=false, no `docker run` at all),
        // which is why tests/integration/test_integration.py's own
        // CPU-checkpoint precedent never had to care about this. The
        // trailing bind mounts params.cell_dino_checkpoint
        // (embed_cells/main.nf's checkpoint_path=${params.cell_dino_checkpoint})
        // at its own, unchanged absolute path regardless -- that param is
        // a plain Hydra-override string, never declared as a Nextflow
        // `path` input, so Nextflow's Docker executor (which by default
        // bind-mounts only the task's own workDir) never stages/binds it
        // on its own. Folded into this one process_gpu containerOptions
        // (not a separate withName: 'EMBED_CELLS' block) because
        // EMBED_CELLS is this pipeline's only process_gpu label, and a
        // second containerOptions assignment for the same process would
        // clobber this one rather than merge with it -- confirmed against
        // a real Nextflow 26.04.6 run. See BUILD_CELL_IMAGES'
        // containerOptions below for the fuller bind-mount rationale (same
        // underlying gap, confirmed by
        // tests/integration/test_integration.py's --container mode) and
        // docs/nextflow.md's "Docker and Singularity/Apptainer: arbitrary
        // host paths" section.
        //
        // Engine-aware, per the `bind`/`gpu_flag` ternaries below: Docker
        // spells these `-v src:dest`/`--gpus all`, Singularity/Apptainer
        // spells them `-B src:dest`/`--nv`, and feeding one engine the
        // other's flag is a hard failure, not a warning -- a real
        // -profile sge run on the Fowler lab cluster (Apptainer behind a
        // `singularity` symlink) died on exactly that: `Error for command
        // "exec": unknown shorthand flag: 'v' in -v`. `src:dest` itself is
        // valid for both, so the flag name is the only difference.
        // `workflow.containerEngine` DOES resolve inside a containerOptions
        // closure (confirmed against a real Nextflow 26.04.6 run: the
        // generated `docker run` line carried the closure's output) even
        // though `workflow` is famously NOT defined at config-PARSE time --
        // see profiles.local's own `projectDir` comment below for that other
        // half. It reports 'singularity' whenever `singularity.enabled` is
        // set, regardless of whether the binary on PATH is really Apptainer
        // (also confirmed directly), and 'apptainer' only under the separate
        // `apptainer` config scope -- hence matching both names.
        containerOptions = {
            def is_singularity = workflow.containerEngine in ['singularity', 'apptainer']
            def gpu_flag = params.cell_dino_device == 'cpu' ? '' : (is_singularity ? '--nv ' : '--gpus all ')
            def bind = is_singularity ? '-B' : '-v'
            "${gpu_flag}${bind} ${params.cell_dino_checkpoint}:${params.cell_dino_checkpoint}"
        }
        // TODO: dedicated GPU queue/profile settings for your executor
        // (SGE/Slurm/etc.) go here.
    }

    // Every module now carries exactly one nf-core bundled resource label
    // (process_single/process_low/process_medium/process_high, alongside
    // process_gpu on EMBED_CELLS) -- see docs/nextflow.md's "nf-core
    // conventions" section. Deliberately no withLabel: resource block for
    // any of the four here: this pipeline has never had a cpu/memory cap on
    // any process, and inventing untested numbers for a GPU/CPU-heavy
    // production pipeline risks breaking real runs. The labels are inert
    // today -- they just name each process' relative weight so a future
    // withLabel: 'process_medium' { cpus = ...; memory = ... } block (like
    // the fisseq-data-pipeline sibling's own conf/base.config) can plug in
    // without touching any module file.
    // TODO: numeric cpus/memory per label, once tuned against a real run.

    // BUILD_CELL_IMAGES is the only process that reaches starcall-workflow's
    // own tree directly (modules/local/build_cell_images/main.nf): its
    // starcall_workflow_dir (a Groovy value interpolated straight into the
    // script's --directory flag) plus whichever of phenotyping_dir/
    // segmentation_dir/sequencing_dir an experiment overrides explicitly are
    // all plain Hydra-override-shaped host paths, never declared as
    // Nextflow `path` inputs -- same gap as cell_dino_checkpoint above.
    // Without this, tests/integration/test_integration.py's --container mode
    // reproduces the failure exactly: `nextflow run` exits 0 (BUILD_CELL_IMAGES'
    // errorStrategy 'ignore' swallows the container-side "No such file or
    // directory" on starcall_workflow_dir) but cell_table.parquet is never
    // written, because the real `snakemake` invocation inside the container
    // can't see starcall_workflow_dir at all. Bind every host path this
    // task might reach at its own, unchanged absolute path -- both the
    // wrapper.smk's --directory and starcall-workflow's own
    // rules (called through it) build every output path by literal string
    // concatenation onto phenotyping_dir/segmentation_dir/sequencing_dir,
    // so the in-container path has to match the host path exactly, not
    // just be reachable some other way. Evaluated per-task, with access to
    // the process' own batch_config input variable, exactly as if this
    // closure were written inline in build_cell_images/main.nf itself --
    // confirmed against a real Nextflow 26.04.6 run. `bind` picks the
    // engine's own bind flag (`-v` for Docker, `-B` for Singularity/
    // Apptainer) rather than hard-coding Docker's, so a Singularity profile
    // gets these binds too instead of an "unknown shorthand flag: 'v' in
    // -v" crash -- see the process_gpu containerOptions above for the full
    // rationale on that ternary, and docs/nextflow.md's "Docker and
    // Singularity/Apptainer: arbitrary host paths" section. A Singularity
    // profile still wants a broad `singularity.runOptions = '-B <root>'`
    // covering whatever host roots params.yaml can point into (which makes
    // the binds here belt-and-braces), since these three selectors are the
    // only place any host path is known at all -- anything a task reaches
    // outside them rides on runOptions alone.
    withName: 'BUILD_CELL_IMAGES' {
        containerOptions = {
            def bind = workflow.containerEngine in ['singularity', 'apptainer'] ? '-B' : '-v'
            def overridden_dirs = ['phenotyping_dir', 'segmentation_dir', 'sequencing_dir'].findAll { key -> batch_config.containsKey(key) }.collect { key -> batch_config[key] }
            def host_paths = ([batch_config.starcall_workflow_dir] + overridden_dirs).unique()
            host_paths.collect { host_path -> "${bind} ${host_path}:${host_path}" }.join(' ')
        }
    }

    // BUILD_DATASET/BUILD_CP_FEATURES: same gap again, one hop downstream,
    // and with a second layer to it. workflows/embeddings.nf injects
    // cell_images_dir -- BUILD_CELL_IMAGES' own OUTPUT, i.e.
    // path("cell_table.parquet").getParent(), a real Nextflow `path` value
    // scoped to *that* task's own workDir -- into each of these processes'
    // batch_config as a plain string (cell_images_dir=${it}, not a
    // declared `path` input), for the same -resume-cache-key-should-be-
    // scalars reason build_dataset/main.nf/build_cp_features/main.nf's own top
    // comments give. That means Nextflow never stages it for THESE
    // processes either, and since each process only gets its own task
    // workDir bind-mounted, BUILD_DATASET's container can't see
    // BUILD_CELL_IMAGES' task workDir any more than BUILD_CELL_IMAGES'
    // container could see an arbitrary starcall_workflow_dir above --
    // confirmed directly: a from-scratch real-starcall run got past the
    // BUILD_CELL_IMAGES fix above only to fail identically one stage later
    // (`nextflow run` exits 0, dataset/<batch_stem>/metadata.parquet never
    // gets written, because BUILD_DATASET's own
    // `pl.read_parquet(cell_images_dir/cell_table.parquet)` can't see
    // cell_images_dir at all inside its container).
    //
    // Bind-mounting cell_images_dir itself is NOT enough, though --
    // confirmed the same way, one layer deeper: build_cell_images/main.nf's own
    // symlink loop (`ln -s "$abs_path" "$rel_path" < symlinks.txt`)
    // populates cell_images_dir's own `{well}_grid<N>/tile<x>x<y>y/
    // *_crops_*.tif` entries as SYMLINKS pointing at the real
    // phenotyping_dir/sequencing_dir tree (deliberately -- see that
    // module's own comment on why this stays a symlink regardless of
    // params.cell_images_hard_copy: copying multi-GB crop stacks into
    // Nextflow's own work tree a second time is exactly the disk-space
    // blowup this whole module exists to avoid). So cell_images_dir "looks"
    // self-sufficient (matching this module's own "no starcall-workflow-
    // facing field reaches BUILD_DATASET/BUILD_CP_FEATURES any more"
    // principle) but isn't, byte-for-byte, once a container boundary is in
    // the way: BUILD_DATASET's `tifffile.imread(crops_tif)` dereferences
    // that symlink and hits the exact same invisible-host-path problem one
    // hop further out. Rather than threading starcall_workflow_dir through
    // batch_config too (reintroducing the very starcall-workflow-facing
    // field this stage's own docstring says it doesn't need), read
    // BUILD_CELL_IMAGES' own resolved_dirs.env -- already sitting inside
    // cell_images_dir, already computed once by that stage's phase 1 (see
    // build_cell_images_enumerate.py's resolve_data_dir) -- and bind-mount
    // the phenotyping_dir/segmentation_dir/sequencing_dir values it names,
    // in addition to cell_images_dir itself. Reading that file here is
    // fine even though it lives inside cell_images_dir: this closure runs
    // as plain Groovy on the HOST (building the `docker run`/`apptainer
    // exec` invocation), never inside a container itself. Both processes
    // take the same shape (`tuple val(batch_stem), val(batch_config)`) so
    // one shared closure covers both via a single withName selector --
    // Nextflow's selector syntax accepts a pipe-separated list. `bind`
    // picks the engine's own bind flag exactly as BUILD_CELL_IMAGES'
    // closure above does; see that block, and the process_gpu one above
    // it, for the full rationale.
    withName: 'BUILD_DATASET|BUILD_CP_FEATURES' {
        containerOptions = {
            def bind = workflow.containerEngine in ['singularity', 'apptainer'] ? '-B' : '-v'
            def resolved_dirs_file = new File("${batch_config.cell_images_dir}/resolved_dirs.env")
            def resolved_dirs = resolved_dirs_file.exists()
                ? resolved_dirs_file.readLines().findAll { line -> line.contains('=') }.collect { line -> line.split('=', 2)[1].replaceAll("^'|'\$", '') }
                : []
            (resolved_dirs + [batch_config.cell_images_dir]).unique().collect { host_path -> "${bind} ${host_path}:${host_path}" }.join(' ')
        }
    }
}

profiles {
    // No container -- every process runs `python -m
    // fisseq_embeddings_pipeline.<module>` directly against whatever
    // Python environment invoked `nextflow run` (this repo's own venv, in
    // practice), rather than fisseq-embeddings-pipeline:latest. Exists so
    // tests/integration/test_integration.py (and any Docker-less/GPU-less
    // CI runner) can exercise the real pipeline without building the image
    // first -- the production path is still containerized by default (no
    // -profile flag needed for that).
    local {
        docker.enabled = false
        process.container = null
        // BUILD_CELL_IMAGES' snakemake invocation defaults to the ops
        // conda env's absolute path (process.ext.snakemake_bin above),
        // since that env is deliberately kept off PATH inside the Docker
        // image -- but under this profile there's no Docker image/ops env
        // to point at at all, so fall back to bare `snakemake`, resolved
        // via PATH like every other tool this profile runs directly off
        // the host.
        process.ext.snakemake_bin = 'snakemake'
        // No /opt/conda under this profile either -- conda_bin_dir's own
        // PATH-prefix is skipped entirely when empty (see its own comment
        // above); bare `conda`, if --use-conda needs it, resolves via the
        // host's own PATH like every other tool this profile runs directly
        // off the host.
        process.ext.conda_bin_dir = ''
        // No baked image under this profile either -- source the wrapper
        // template pair straight from the checked-out repo instead of the
        // image path above. `projectDir` (not `workflow.projectDir` --
        // `workflow` isn't defined at config-parse time, confirmed against
        // a real Nextflow 26.04.6 run: "`workflow` is not defined") is the
        // implicit config-file variable for this repo's own root.
        process.ext.starcall_overrides_dir = "${projectDir}/resources/starcall_overrides"
    }
    // sge {
    //     process.executor = 'sge'
    //     ... (see fisseq-data-pipeline's nextflow.config for a worked example)
    // }
    // singularity {
    //     singularity.enabled = true
    //     docker.enabled = false
    //     process.container = "path/to/image.sif"
    // }
}
