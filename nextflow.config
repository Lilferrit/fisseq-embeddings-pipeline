// nextflow.config -- container and profile settings only. Default parameter
// values live in params.yaml, loaded explicitly:
//
//   nextflow run . -params-file params.yaml --pipeline_dir /path/to/run \
//       --cell_dino_checkpoint /path/to/checkpoint.pth [-profile apptainer]
//
// No executor settings live here either. On a cluster, pass your own site
// config with `-c site.config` (executor, queue, per-label cpus/memory,
// apptainer cache dir, extra bind paths) -- see docs/nextflow.md. The nested
// starcall run's cluster settings are a separate, snakemake-side profile:
// params.starcall_profile.
//
// Don't add an empty top-level `params {}` block: combined with
// -params-file it made Nextflow <26 misattribute every params.yaml key into
// the process scope ("Unknown config attribute `params`").

docker {
    enabled = true
    // Run as the invoking user, so published outputs aren't root-owned.
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    container = params.container_image

    // BUILD_CELL_IMAGES' nested starcall snakemake: the image's ops conda
    // env, reached by absolute path. That env is kept off PATH on purpose,
    // so bare `python` always resolves to this repo's own 3.13 venv rather
    // than ambiguously to the env's 3.10. --use-conda shells out to a bare
    // `conda` regardless of snakemake's own path, so conda_bin_dir is
    // prepended onto PATH for that one invocation only.
    ext.snakemake_bin = '/opt/conda/envs/ops/bin/snakemake'
    ext.conda_bin_dir = '/opt/conda/bin'

    // Host paths each containerized task needs beyond its own staged
    // inputs, bound at their unchanged locations (starcall's rules build
    // every path by string concatenation, so the in-container path has to
    // match the host path exactly). `-v` for docker, `-B` for apptainer.
    withName: 'BUILD_CELL_IMAGES' {
        containerOptions = {
            def is_apptainer = workflow.containerEngine in ['singularity', 'apptainer']
            def bind = is_apptainer ? '-B' : '-v'
            def gpu_flag = params.starcall_gpu ? (is_apptainer ? '--nv ' : '--gpus all ') : ''
            def cache_dir = params.snakemake_cache_dir ?: "${params.pipeline_dir}/.snakemake_cache"
            def host_paths = (plan.bind_paths + [cache_dir] + (params.starcall_profile ? [params.starcall_profile] : [])).unique()
            gpu_flag + host_paths.collect { p -> "${bind} ${p}:${p}" }.join(' ')
        }
    }
    withName: 'BUILD_DATASET' {
        containerOptions = {
            def bind = workflow.containerEngine in ['singularity', 'apptainer'] ? '-B' : '-v'
            "${bind} ${phenotyping_dir}:${phenotyping_dir}"
        }
    }
    withName: 'EMBED_CELLS' {
        containerOptions = {
            def is_apptainer = workflow.containerEngine in ['singularity', 'apptainer']
            def bind = is_apptainer ? '-B' : '-v'
            def gpu_flag = params.cell_dino_device == 'cpu' ? '' : (is_apptainer ? '--nv ' : '--gpus all ')
            "${gpu_flag}${bind} ${params.cell_dino_checkpoint}:${params.cell_dino_checkpoint}"
        }
    }
}

profiles {
    // Run every task in the image through Apptainer instead of Docker --
    // the usual choice on an HPC cluster. It runs the same docker:// image.
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    // No container at all: every task runs in the invoking environment
    // (this repo's own uv venv). What the integration suite and CI use.
    // There is no ops env here, so the nested snakemake is whatever
    // `snakemake` is on PATH -- the suite puts a stub there.
    local {
        docker.enabled = false
        process.container = null
        process.ext.snakemake_bin = 'snakemake'
        process.ext.conda_bin_dir = ''
    }
}
