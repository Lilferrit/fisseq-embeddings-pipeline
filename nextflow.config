// nextflow.config -- executor/profile/container settings only. No default
// parameter values live here; those are in params.yaml, loaded explicitly
// via `-params-file params.yaml`.
//
// pass with: nextflow run . --pipeline_dir /path/to/experiment \
//   -params-file params.yaml [-profile docker|sge] [other overrides]

docker {
    enabled = true
}

process {
    // params.container_image itself has a default in params.yaml -- read
    // here without ever declaring a `params {}` block of our own, since
    // `params.*` is always implicitly available in nextflow.config (it
    // resolves to null, harmlessly, if params.yaml wasn't loaded --
    // fails loudly downstream instead, per §9.1's Resolved note). An
    // empty top-level `params {}` block used to sit here for the same
    // purpose, but it triggers a real Nextflow <26 bug: combined with
    // `-params-file`, ConfigBuilder misattributes every params.yaml key
    // into this process {} scope instead of top-level, raising "Unknown
    // config attribute `params`" (confirmed against Nextflow 25.10.4;
    // fixed by 26.04.6). Don't reintroduce an empty `params {}` block here.
    // Every process module declares its own `container "${params...}"`
    // directive inline (see e.g. modules/local/build_dataset.nf), which
    // takes precedence over this blanket default -- this line only
    // matters as a fallback for a process that doesn't. BUILD_CELL_IMAGES
    // (modules/local/build_cell_images.nf) inline-declares
    // `container "${params.starcall_container_image}"`, a *different*
    // image from this default -- see that module's own header comment and
    // docker/starcall.Dockerfile.
    container = params.container_image

    withLabel: 'process_gpu' {
        containerOptions = '--gpus all'
        // TODO: dedicated GPU queue/profile settings for your executor
        // (SGE/Slurm/etc.) go here.
    }
}

profiles {
    // No container -- every process runs `python -m
    // fisseq_embeddings_pipeline.<module>` directly against whatever
    // Python environment invoked `nextflow run` (this repo's own venv, in
    // practice), rather than fisseq-embeddings-pipeline:latest. Exists so
    // tests/integration/test_integration.py (and any Docker-less/GPU-less
    // CI runner) can exercise the real pipeline without building the image
    // first -- the production path is still containerized by default (no
    // -profile flag needed for that).
    local {
        docker.enabled = false
        process.container = null
    }
    // sge {
    //     process.executor = 'sge'
    //     ... (see fisseq-data-pipeline's nextflow.config for a worked example)
    // }
    // singularity {
    //     singularity.enabled = true
    //     docker.enabled = false
    //     process.container = "path/to/image.sif"
    // }
}
