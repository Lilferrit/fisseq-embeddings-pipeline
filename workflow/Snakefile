# fisseq-embeddings-pipeline. Cell images -> WebDataset -> Cell-DINO
# embeddings -> QC/normalize -> per-experiment aggregation + one-vs-wildtype
# scoring -> cross-experiment pooling, with an optional parallel
# CellProfiler-feature track over the same cells.
#
#   snakemake --configfile params.yaml --config pipeline_dir=/path/to/experiment \
#       cell_dino_checkpoint=/path/to/checkpoint.pth -c 8
#
# Add `--software-deployment-method apptainer --profile profiles/apptainer`
# to run every rule in the published image instead of the invoking Python
# environment. See docs/snakemake.md.

import os
import re


configfile: "params.yaml"


include: "rules/common.smk"


# Every rule's output path is relative to pipeline_dir, so the rule files
# read exactly like the output tree in docs/snakemake.md -- and .snakemake/
# lands beside the outputs the way Nextflow's work/ did. Note this runs
# AFTER common.smk has resolved every repo-relative path to an absolute one.
workdir: PIPELINE_DIR


include: "rules/cell_images.smk"
include: "rules/embeddings.smk"
include: "rules/cp_features.smk"
include: "rules/global_stages.smk"


rule all:
    """The two tracks' terminal outputs.

    The CellProfiler four are requested only when some experiment opts in
    with `cp_features: true` -- the same gate workflows/embeddings.nf spelled
    as `if (cp_experiments)`, so a cellDINO-only run is unchanged.
    """
    input:
        "global/embeddings/pca_reduced.parquet",
        "global/distinguishability/global_scores.parquet",
        # The reproducibility chain's per-experiment terminal deliverable.
        # Requested explicitly because nothing downstream reads it --
        # global_variant_embeddings consumes the unfiltered aggregate plus
        # the global blocklist (see global_stages.smk) -- so without this it
        # would never be built.
        expand(
            "feature_select_batchwise/{batch}/aggregate_with_passthrough.parquet",
            batch=BATCHES,
        ),
        (
            [
                "global/cp_features/pca_reduced.parquet",
                "global/distinguishability_cp_features/global_scores.parquet",
            ]
            if CP_BATCHES
            else []
        ),
    default_target: True
