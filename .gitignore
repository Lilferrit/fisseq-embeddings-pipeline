# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Vscode
.vscode/*
.vscode/

# Other stuff
.ruff_cache/
.pytest_cache/
.claude/
.codegraph/
.devcontainer-tmp/

# Generated docs output
site/

# Snakemake
.snakemake/
# Rendered DAG images from `snakemake --dag | dot -Tsvg`
dag.svg
dag.png

# Model checkpoints / large artifacts (kept out of git; documented in README)
*.pth
*.ckpt

# Scratch Directory
scratch/
scratch/*

# Real starcall-workflow test fixture (tests/integration/test_integration.py,
# --container mode)
# -- fetched/generated by scripts/prepare_real_starcall_test_data.py, not
# committed (multi-hundred-MB real microscopy data); the folder itself
# stays tracked (see testing_data/README.md) so a fresh checkout has
# somewhere to put it.
testing_data/*
!testing_data/README.md

# Hydra CLI runs default to ./outputs/<date>/<time>/ when a stage is invoked
# by hand without output_dir pointing elsewhere. Never a pipeline result --
# every rule passes an explicit output_dir under pipeline_dir.
outputs/
