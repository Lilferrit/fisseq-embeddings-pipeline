# Model checkpoints / large artifacts (kept out of git; documented in README)
*.pth
*.ckpt

# Scratch Directory
scratch/
scratch/*

# Real starcall-workflow test fixture (tests/integration/test_integration_real_starcall.py)
# -- fetched/generated by scripts/prepare_real_starcall_test_data.py, not
# committed (multi-hundred-MB real microscopy data); the folder itself
# stays tracked (see testing_data/README.md) so a fresh checkout has
# somewhere to put it.
testing_data/*
!testing_data/README.md
