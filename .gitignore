# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Vscode
.vscode/*
.vscode/

# Other stuff
.ruff_cache/
.pytest_cache/
.claude/
.codegraph/
.devcontainer-tmp/

# Generated docs output
site/

# Nextflow
.nextflow/
.nextflow.log*
work/
nf-report*.html
nf-timeline*.html
nf-trace*.txt
